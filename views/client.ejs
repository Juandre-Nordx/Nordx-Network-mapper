<%- include('header') %><a href="/">← All clients</a><p class="eyebrow">CLIENT</p><h1><%= client.name %></h1><p><%= client.contact %></p><div class="grid"><section><h2>Sites</h2><% if(!sites.length){ %><p class="card empty">Add a site to create plans and equipment inventories.</p><% } %><% sites.forEach(s=>{ %><a class="card item" href="/sites/<%= s.id %>"><h3><%= s.name %> ↗</h3><p><%= s.address %></p></a><% }) %></section><form class="card stack" action="/clients/<%= client.id %>/sites" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Add site</h2><label>Site name<input name="name" maxlength="200" required></label><label>Address<textarea name="address" maxlength="2000"></textarea></label><button>Create site</button></form></div><% if(user.role==='admin'){ %><section class="card"><h2>Technician access</h2><p>Assigned technicians can view and edit all sites and plans for this client.</p><% users.forEach(u=>{ %><form class="row" action="/clients/<%= client.id %>/access" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="userId" value="<%= u.id %>"><span><%= u.name %></span><input type="hidden" name="assigned" value="<%= u.assigned?'no':'yes' %>"><button><%= u.assigned?'Remove access':'Grant access' %></button></form><% }) %></section><% } %><%- include('footer') %>
