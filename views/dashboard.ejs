<%- include('header') %><p class="eyebrow">WORKSPACE</p><h1>Your clients, connected.</h1><p>Organise sites, plan networks, and keep every detail in one place.</p><div class="grid"><section><h2>Clients <span class="badge"><%= clients.length %></span></h2><% if(!clients.length){ %><div class="card empty">No clients yet. <%= user.role==='admin'?'Create your first client to start planning.':'Ask an administrator to assign a client.' %></div><% } %><% clients.forEach(c=>{ %><a class="card item" href="/clients/<%= c.id %>"><h3><%= c.name %> <span>↗</span></h3><p><%= c.contact||'No contact details' %></p></a><% }) %></section><% if(user.role==='admin'){ %><form class="card stack" method="post" action="/clients"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>New client</h2><label>Client name<input name="name" required maxlength="200"></label><label>Contact details<textarea name="contact" maxlength="2000"></textarea></label><button>Create client</button></form><% } %></div><%- include('footer') %>
