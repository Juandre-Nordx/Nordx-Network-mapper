<%- include('header') %><a href="/clients/<%= site.client_id %>">← <%= site.client_name %></a><p class="eyebrow">SITE</p><h1><%= site.name %></h1><p><%= site.address %></p><div class="grid"><section><h2>Plans</h2><% if(!plans.length){ %><p class="card empty">Start with a blank canvas or a reusable template.</p><% } %><% plans.forEach(p=>{ %><a class="card item" href="/plans/<%= p.id %>"><h3><%= p.name %> ↗</h3><span class="badge"><%= p.kind %></span></a><% }) %></section><form class="card stack" method="post" action="/sites/<%= site.id %>/plans"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Create plan</h2><label>Plan name<input name="name" maxlength="200" required></label><label>Plan type<select name="kind"><option value="network">Network topology</option><option value="cctv">CCTV map</option></select></label><label>Template<select name="template"><option value="blank">Blank canvas</option><option value="office">Office network</option><option value="cctv">CCTV starter</option></select></label><button>Create plan</button></form></div><section class="card"><h2>Equipment inventory</h2><div class="table-wrap"><table><thead><tr><th>Name</th><th>Type</th><th>IP / address</th><th>Notes</th></tr></thead><tbody><% equipment.forEach(e=>{ %><tr><td><%= e.name %></td><td><%= e.kind %></td><td><%= e.ip %></td><td><%= e.notes %></td></tr><% }) %></tbody></table></div><form class="row" method="post" action="/sites/<%= site.id %>/equipment"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Name<input name="name" required maxlength="200"></label><label>Type<input name="kind" required maxlength="200" placeholder="Switch, camera…"></label><label>IP / address<input name="ip" maxlength="2000"></label><label>Notes<input name="notes" maxlength="2000"></label><button>Add equipment</button></form></section><section class="card"><h2>Site images & floor plans</h2><p>Private PNG or JPEG images, up to 10 MB each.</p><div class="row"><% uploads.forEach(u=>{ %><a href="/uploads/<%= u.id %>"><%= u.original_name %></a><% }) %></div><form class="row" method="post" enctype="multipart/form-data" action="/sites/<%= site.id %>/uploads"><input type="file" name="file" accept="image/png,image/jpeg" required><button>Upload</button></form></section><%- include('footer') %>
