<%- include('header') %><a href="/sites/<%= plan.site_id %>">← <%= plan.site_name %></a><div class="row heading"><div><p class="eyebrow"><%= plan.kind %> PLAN</p><h1><%= plan.name %></h1></div><a class="button" href="/plans/<%= plan.id %>/pdf">Export PDF</a></div><section class="card"><div class="row toolbar"><label>Device label<input id="label" maxlength="200" value="New device"></label><label>Type<select id="type"><option>router</option><option>switch</option><option>wifi</option><option>camera</option><option>nvr</option><option>server</option><option>workstation</option></select></label><button id="add">Add device</button><button id="connect" class="quiet">Connect devices</button><button id="remove" class="quiet">Delete selected</button><button id="save">Save diagram</button></div><div class="row"><label>Floor-plan background<select id="background"><option value="">None</option><% uploads.forEach(u=>{ %><option value="<%= u.id %>"><%= u.original_name %></option><% }) %></select></label><span id="status" role="status">Drag devices to position them. Click two devices in connect mode.</span></div><div class="canvas"><svg id="diagram" viewBox="0 0 1200 800" data-plan-id="<%= plan.id %>" role="img" aria-label="Editable network diagram"></svg></div><p>Background images are saved with the plan. PDF exports contain topology and labels.</p></section><script id="initial-diagram" type="application/json"><%- diagramJson %></script><script src="/editor.js" defer></script><%- include('footer') %>
