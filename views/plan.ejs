<%- include('header') %><a href="/sites/<%= plan.site_id %>">← <%= plan.site_name %></a><div class="row heading"><div><p class="eyebrow"><%= plan.kind %> PLAN</p><h1><%= plan.name %></h1></div><a class="button" href="/plans/<%= plan.id %>/pdf">Export PDF</a></div><section class="card"><div class="row toolbar"><label>Device label<input id="label" maxlength="200" value="New device"></label><label>Type<select id="type"><option>router</option><option>switch</option><option>wifi</option><option>camera</option><option>nvr</option><option>server</option><option>workstation</option><option value="voip">VoIP phone</option></select></label><button id="add">Add device</button><button id="pan-canvas" class="quiet" aria-pressed="false">Pan canvas</button><button id="reset-view" class="quiet">Reset view</button><button id="connect" class="quiet">Connect devices</button><button id="remove" class="quiet">Delete selected</button><button id="save">Save diagram</button></div><div class="row"><label>Floor-plan background<select id="background"><option value="">None</option><% uploads.forEach(u=>{ %><option value="<%= u.id %>"><%= u.original_name %></option><% }) %></select></label><span id="status" role="status">Drag empty canvas space to move around. Drag devices to reposition them, or use Pan canvas to move from anywhere.</span></div><div class="canvas"><svg id="diagram" viewBox="0 0 1200 800" data-plan-id="<%= plan.id %>" role="img" aria-label="Editable network diagram"></svg></div><form id="device-size-form" class="row device-size-controls" hidden><strong>Selected device size</strong><label>Width<input id="device-width" type="number" min="80" max="360" step="1" required></label><label>Height<input id="device-height" type="number" min="48" max="240" step="1" required></label><button type="submit" class="quiet">Apply size</button><small>Drag the selected device’s corner handle, or enter its size here.</small></form><p>M = master port (first device); S = slave port (second device). Click a connection to edit its ports. Background images are saved with the plan. PDF exports include a connection-port schedule.</p></section><dialog id="port-dialog" aria-labelledby="port-dialog-title"><form id="port-form" class="stack"><h2 id="port-dialog-title">Connection ports</h2><p id="port-devices"></p><label>Master port<input id="master-port" name="masterPort" required maxlength="64" placeholder="e.g. ether1 or Gi0/1"></label><label>Slave port<input id="slave-port" name="slavePort" required maxlength="64" placeholder="e.g. ether2 or uplink"></label><p id="port-error" role="alert"></p><div class="row"><button type="button" id="port-cancel" class="quiet">Cancel</button><button type="submit">Apply connection</button></div></form></dialog><script id="initial-diagram" type="application/json"><%- diagramJson %></script><script src="/editor.js" defer></script><%- include('footer') %>
