<%- include('header') %><p class="eyebrow">ADMINISTRATION</p><h1>Your team</h1><div class="grid"><section class="card"><h2>Members</h2><% users.forEach(u=>{ %><div class="item"><h3><%= u.name %> <span class="badge"><%= u.role %></span></h3><p><%= u.email %></p></div><% }) %></section><form class="card stack" method="post" action="/users"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Create member</h2><label>Name<input name="name" required maxlength="200"></label><label>Email<input type="email" name="email" required maxlength="200"></label><label>Initial password<input type="password" name="password" required minlength="12" maxlength="128" autocomplete="new-password"></label><label>Role<select name="role"><option value="technician">Technician</option><option value="admin">Administrator</option></select></label><button>Create member</button><small>Assign technicians to clients from the client page. Share initial passwords through a secure channel.</small></form></div><%- include('footer') %>
