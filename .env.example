NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://nordx:replace-me@localhost:5432/nordx
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
